{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deepdeckleague.com/contracts/agent-manifest/v1/schema.json",
  "title": "Deep Deck agent manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "agentId",
    "name",
    "version",
    "authors",
    "compatibility"
  ],
  "properties": {
    "schemaVersion": {
      "const": "agent-manifest/v1"
    },
    "agentId": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "agentType": {
      "type": "string",
      "enum": [
        "deep_learning",
        "reinforcement_learning",
        "alpha_star",
        "rules_engine",
        "search",
        "hybrid",
        "human_ui",
        "other"
      ],
      "default": "other"
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/author"
      }
    },
    "repository": {
      "$ref": "#/$defs/repository"
    },
    "publications": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/publication"
      },
      "default": []
    },
    "compatibility": {
      "$ref": "#/$defs/compatibility"
    },
    "capabilities": {
      "$ref": "#/$defs/capabilities"
    }
  },
  "$defs": {
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "orcid": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string"
        },
        "license": {
          "type": "string"
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "venue": {
          "type": "string"
        },
        "year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 3000
        },
        "doi": {
          "type": "string"
        },
        "arxiv": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "citation": {
          "type": "string"
        }
      }
    },
    "deckSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection"
      ],
      "properties": {
        "selection": {
          "enum": [
            "all",
            "allow-list"
          ]
        },
        "deckIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "selection": {
                "const": "allow-list"
              }
            }
          },
          "then": {
            "required": [
              "deckIds"
            ],
            "properties": {
              "deckIds": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "deckIds": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gameModes",
        "decks",
        "timeControls",
        "observationStreams",
        "gameSharing"
      ],
      "properties": {
        "gameModes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "decks": {
          "$ref": "#/$defs/deckSelection"
        },
        "timeControls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "realtime",
              "standard",
              "extended",
              "offline"
            ]
          }
        },
        "observationStreams": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "full-observation-stream",
              "delta-event-stream"
            ]
          }
        },
        "gameSharing": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "private",
              "results-only",
              "public-replay",
              "research-dataset",
              "training-dataset"
            ]
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startingSituationAnalysis": {
          "type": "boolean",
          "default": false
        },
        "decisionExploration": {
          "type": "boolean",
          "default": false
        },
        "statefulMemory": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}
