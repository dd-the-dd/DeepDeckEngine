  "id": "replacement/named-source-entry-state",
  "cases": [
    {
      "id": "exact-timeless-lotus",
      "request": {
        "cardName": "Timeless Lotus",
        "typeLine": "Legendary Artifact",
        "manaCost": "{5}",
        "oracleText": "Timeless Lotus enters tapped.\n{T}: Add {W}{U}{B}{R}{G}.",
        "layout": "normal",
        "faces": []
      },
      "expect": {
        "outcome": "success",
        "cardStatus": "canonical",
        "abilityCount": 2,
        "abilities": [
          {
            "index": 0,
            "status": "canonical",
            "recognizer": "native",
            "abilityType": "replacementEffect",
            "rule": {
              "kind": "replacementEffect",
              "source": { "kind": "self" },
              "event": {
                "kind": "wouldEnterBattlefield",
                "object": { "kind": "self" }
              },
              "replacement": [{
                "kind": "setEnteringState",
                "object": { "kind": "self" },
                "tapped": true
              }]
            }
          },
          {
            "index": 1,
            "status": "canonical",
            "recognizer": "native",
            "abilityType": "manaAbility",
            "rule": {
              "kind": "manaAbility",
              "source": { "kind": "self" },
              "costs": [{ "kind": "tap", "object": { "kind": "self" } }],
              "effects": [{
                "kind": "addMana",
                "player": {
                  "kind": "controllerOf",
                  "object": { "kind": "self" }
                },
                "mana": "{W}{U}{B}{R}{G}"
              }]
            }
          }
        ]
      }
    },
    {
