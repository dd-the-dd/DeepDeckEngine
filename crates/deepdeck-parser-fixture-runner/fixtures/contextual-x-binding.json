    {
      "id": "vicious-rivalry-rejects-x-without-a-producer",
      "request": {
        "cardName": "Vicious Rivalry",
        "typeLine": "Sorcery",
        "manaCost": "{2}{B}{G}",
        "oracleText": "As an additional cost to cast this spell, pay X life.\nDestroy all artifacts and creatures with mana value X or less.",
        "layout": "normal",
        "faces": []
      },
      "expect": {
        "outcome": "failure",
        "cardStatus": "unsupported",
        "abilityCount": 2,
        "abilities": [
          {
            "index": 0,
            "status": "unsupported",
            "recognizer": "native",
            "abilityType": "spellAbility"
          },
          {
            "index": 1,
            "status": "unsupported",
            "recognizer": "native",
            "abilityType": "spellAbility"
          }
        ],
        "diagnostics": [
          {
            "abilityIndex": 0,
            "code": "oracle_machine_failure",
            "automaton": "additional-cost",
            "state": "cost.pay-life.amount-supported",
            "expectedContains": "a fixed integer life payment",
            "found": "X"
          },
          {
            "abilityIndex": 1,
            "code": "oracle_context_binding_failure",
            "automaton": "card-context-binding",
            "state": "binding.x-value.source",
            "expectedContains": "xValue declaration or {X}",
            "found": "{2}{B}{G}"
          }
        ]
      }
    },
