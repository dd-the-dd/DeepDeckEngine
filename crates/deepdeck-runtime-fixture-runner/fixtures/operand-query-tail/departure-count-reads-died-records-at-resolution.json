        "battlefield": [
          { "id": "own-zubera", "name": "Own Zubera", "typeLine": "Creature - Zubera Spirit", "power": "1", "toughness": "2" },
          { "id": "own-bear", "name": "Own Bear", "typeLine": "Creature - Bear", "power": "2", "toughness": "2" },
          {
            "id": "own-zubera-token",
            "name": "Zubera Token",
            "typeLine": "Creature - Zubera Spirit",
            "power": "1",
            "toughness": "1",
            "isToken": true
          }
        ]
      },
      {
        "id": "player-1",
        "name": "Opponent",
        "battlefield": [
          { "id": "opposing-zubera", "name": "Opposing Zubera", "typeLine": "Creature - Zubera Spirit", "power": "1", "toughness": "2" },
          { "id": "opposing-land", "name": "Opposing Land", "typeLine": "Land" }
