      { "id": "player-1", "name": "Opponent" }
    ]
  },
  "execution": { "controllerId": "player-0", "sourceDefinitionId": "flow-state-direct" },
  "actions": [
    { "kind": "castSpell", "controllerId": "player-0", "sourceDefinitionId": "instant-probe" },
