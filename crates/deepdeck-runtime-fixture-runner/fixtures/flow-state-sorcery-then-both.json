            "operands": [
              { "kind": "integer", "value": 1 },
              { "kind": "countObjects", "objects": { "kind": "boundObjects", "binding": "lookedCards" } }
            ]
          }
        }
      },
      {
        "kind": "moveCards",
        "cards": { "kind": "decisionResult", "decisionId": "cardsForHand" },
        "to": { "kind": "hand", "player": { "kind": "controllerOf", "object": { "kind": "self" } } }
      },
      {
        "kind": "chooseOrder",
        "id": "remainderOrder",
        "player": { "kind": "controllerOf", "object": { "kind": "self" } },
        "objects": {
          "kind": "setDifference",
          "left": { "kind": "boundObjects", "binding": "lookedCards" },
          "right": { "kind": "decisionResult", "decisionId": "cardsForHand" }
        }
      },
      {
        "kind": "moveCards",
        "cards": { "kind": "decisionResult", "decisionId": "remainderOrder" },
        "to": {
          "kind": "library",
          "player": { "kind": "controllerOf", "object": { "kind": "self" } },
          "position": "bottom"
        },
        "order": { "kind": "decisionOrder", "decisionId": "remainderOrder" }
      }
    ]
  },
  "initialState": {
