            "kind": "and",
            "operands": [
              {
                "kind": "compare",
                "operator": ">=",
                "left": {
                  "kind": "countCards",
                  "zone": { "kind": "graveyard", "player": { "kind": "controllerOf", "object": { "kind": "self" } } },
                  "where": { "kind": "cardTypeContains", "value": "Instant" }
