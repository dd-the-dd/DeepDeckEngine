                  "kind": "countCards",
                  "zone": { "kind": "graveyard", "player": { "kind": "controllerOf", "object": { "kind": "self" } } },
                  "where": { "kind": "cardTypeContains", "value": "Sorcery" }
                },
                "right": { "kind": "integer", "value": 1 }
              }
            ]
          },
          "ifTrue": {
